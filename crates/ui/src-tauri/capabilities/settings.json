{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "The settings window: config, sources, desktop, start at login, native folder and file dialogs.",
  "windows": ["settings"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "dialog:allow-open",
    "allow-get-config",
    "allow-save-config",
    "allow-app-info",
    "allow-status",
    "allow-daemon-connection",
    "allow-next",
    "allow-prev",
    "allow-pause",
    "allow-resume",
    "allow-favorite",
    "allow-trash",
    "allow-current-thumbnail",
    "allow-check-source",
    "allow-download-now",
    "allow-delete-source-files",
    "allow-open-source-folder",
    "allow-open-folder",
    "allow-fetch-dropped-url",
    "allow-import-dropped-file",
    "allow-desktop-backend",
    "allow-test-desktop",
    "allow-detect-desktop",
    "allow-ensure-daemon",
    "allow-start-at-login",
    "allow-set-start-at-login",
    "allow-reveal",
    "allow-show-picker",
    "allow-open-welcome",
    "allow-reset-picker-position",
    "allow-check-update",
    "allow-install-update",
    "allow-open-update-page"
  ]
}
