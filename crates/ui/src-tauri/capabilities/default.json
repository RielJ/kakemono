{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Settings and picker windows: core APIs, native dialogs, the file manager and autostart.",
  "windows": ["settings", "kakemono-picker"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$HOME/**" }]
    },
    "autostart:default"
  ]
}
