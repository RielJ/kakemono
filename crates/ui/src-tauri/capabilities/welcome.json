{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "welcome",
  "description": "The first-start welcome window: config, Change wallpaper now, start at login, whether a tray exists, and closing itself.",
  "windows": ["welcome"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "allow-get-config",
    "allow-save-config",
    "allow-app-info",
    "allow-daemon-connection",
    "allow-next",
    "allow-start-at-login",
    "allow-set-start-at-login",
    "allow-tray-available"
  ]
}
