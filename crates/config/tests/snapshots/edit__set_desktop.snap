---
source: crates/config/tests/edit.rs
expression: out
---
# My wallpaper config — keep this comment
[daemon]
# How often to rotate
interval = "30m" # trailing comment
cache_size = 50

[wallhaven]
enabled = true
# Search terms
queries = ["nature"]
my_unknown_key = "kept"

# Desktop section below
[desktop]
backend = "swww"
detected_session = "hyprland"
fit = "fill"
managed_by = "user"
persistent = false
set_command = ["swww", "img", "{path}"]
theme = "auto"
