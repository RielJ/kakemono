---
# My wallpaper config — keep this comment
[daemon]
# How often to rotate
interval = "1h" # trailing comment
cache_size = 50
rotate_on_theme_change = false

[wallhaven]
enabled = true
# Search terms
queries = ["space", "city"]

# Desktop section below
[desktop]
backend = "auto"

[bing]
market = "de-DE"

[reddit]
subreddits = ["EarthPorn"]
