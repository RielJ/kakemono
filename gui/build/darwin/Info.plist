<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>CFBundlePackageType</key>
        <string>APPL</string>
        <key>CFBundleName</key>
        <string>{{.Info.ProductName}}</string>
        <key>CFBundleExecutable</key>
        <string>{{.OutputFilename}}</string>
        <key>CFBundleIdentifier</key>
        <string>com.rielj.wallpaperd-settings</string>
        <key>CFBundleVersion</key>
        <string>{{.Info.ProductVersion}}</string>
        <key>CFBundleGetInfoString</key>
        <string>{{.Info.Comments}}</string>
        <key>CFBundleShortVersionString</key>
        <string>{{.Info.ProductVersion}}</string>
        <key>CFBundleIconFile</key>
        <string>iconfile</string>
        <key>LSMinimumSystemVersion</key>
        <string>10.15.0</string>
        <key>NSHighResolutionCapable</key>
        <string>true</string>
        <key>NSHumanReadableCopyright</key>
        <string>{{.Info.Copyright}}</string>
        <!-- Allow the app to access the filesystem for reading config.toml -->
        <key>NSDesktopFolderUsageDescription</key>
        <string>wallpaperd Settings reads and writes your config file.</string>
        <key>NSDocumentsFolderUsageDescription</key>
        <string>wallpaperd Settings accesses your Documents folder.</string>
        <key>NSDownloadsFolderUsageDescription</key>
        <string>wallpaperd Settings accesses your Downloads folder.</string>
    </dict>
</plist>
