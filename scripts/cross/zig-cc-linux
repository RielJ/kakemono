#!/usr/bin/env bash
# C compiler for x86_64-unknown-linux-gnu on macOS, used by scripts/gate.sh when no
# x86_64-linux-gnu-gcc is installed. Drops cc-rs's `--target=` (zig takes `-target`).
args=()
for a in "$@"; do
  [[ "$a" == --target=* ]] || args+=("$a")
done
exec zig cc -target x86_64-linux-gnu "${args[@]}"
